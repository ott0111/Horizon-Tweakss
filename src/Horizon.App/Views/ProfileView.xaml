<UserControl x:Class="Horizon.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
        <Grid Style="{StaticResource PageShell}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True"><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <Grid Width="96" Height="96" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource Brush.Elevated}" Stroke="{StaticResource Brush.BorderStrong}" StrokeThickness="1" />
                                <TextBlock Text="{Binding Initials}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Visibility="{Binding HasProfilePhoto, Converter={StaticResource BooleanToVisibility}}">
                                    <Ellipse.Fill><ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" /></Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding Profile.DisplayName}" FontSize="24" FontWeight="Bold" Margin="0,18,0,0" />
                            <TextBlock Text="{Binding EmailAddress}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />

                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,22,0,18" />
                            <TextBlock Text="PLAN" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding PlanName}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="DEVICE" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                            <TextBlock Text="{Binding DeviceName}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />

                            <Button Content="SIGN OUT" Style="{StaticResource GhostButton}" Command="{Binding SignOutCommand}"
                                    HorizontalAlignment="Left" MinWidth="0" Padding="0,8" Margin="0,22,0,0"
                                    AutomationProperties.Name="Sign out of Horizon" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.Column" Value="2" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True">
                                    <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /><Setter Property="Margin" Value="0,24,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Profile" Style="{StaticResource Heading2}" />
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Width="112" Height="112" HorizontalAlignment="Left">
                                    <Ellipse Fill="{StaticResource Brush.Elevated}" Stroke="{StaticResource Brush.BorderStrong}" StrokeThickness="1" />
                                    <TextBlock Text="{Binding Initials}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Visibility="{Binding HasProfilePhoto, Converter={StaticResource BooleanToVisibility}}">
                                        <Ellipse.Fill><ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" /></Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <Button Content="CHANGE PHOTO" Style="{StaticResource SecondaryButton}" Command="{Binding UploadPhotoCommand}"
                                        HorizontalAlignment="Left" MinWidth="132" Height="38" Margin="0,14,0,0" AutomationProperties.Name="Change profile photo" />
                                <Button Content="USE PROVIDER PHOTO" Style="{StaticResource GhostButton}" Command="{Binding UseProviderPhotoCommand}"
                                        HorizontalAlignment="Left" MinWidth="0" Height="34" Padding="0,6" Margin="0,4,0,0" />
                                <Button Content="REMOVE PHOTO" Style="{StaticResource GhostButton}" Command="{Binding RemovePhotoCommand}"
                                        HorizontalAlignment="Left" MinWidth="0" Height="34" Padding="0,6" Foreground="{StaticResource Brush.TextMuted}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DISPLAY NAME" Style="{StaticResource Eyebrow}" />
                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextInput}" Margin="0,8,0,0"
                                         AutomationProperties.Name="Horizon display name" MaxLength="80" />
                                <TextBlock Text="PREVIEW" Style="{StaticResource Eyebrow}" Margin="0,20,0,0" />
                                <Border Background="{StaticResource Brush.Elevated}" CornerRadius="9" Padding="12" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="34" Height="34">
                                            <Ellipse Fill="{StaticResource Brush.Selected}" />
                                            <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Visibility="{Binding HasProfilePhoto, Converter={StaticResource BooleanToVisibility}}">
                                                <Ellipse.Fill><ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" /></Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <Button Content="SAVE PROFILE" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProfileCommand}"
                                        HorizontalAlignment="Right" MinWidth="132" Margin="0,20,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Sign-in methods" Style="{StaticResource Heading2}" Margin="0,28,0,0" />
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding AccountMethods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionLabel}" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.LinkProviderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" IsEnabled="{Binding CanLink}" Height="36" MinWidth="112" Padding="12,6" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibility}}"
                            Background="{StaticResource Brush.Elevated}" BorderBrush="{StaticResource Brush.Warning}"
                            BorderThickness="3,0,0,0" Padding="14,11" CornerRadius="7" Margin="0,12,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
