<UserControl x:Class="Horizon.App.Views.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource Brush.App}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="1040" MinHeight="650" MaxWidth="1440" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55*" />
                    <ColumnDefinition Width="45*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True">
                    <Rectangle Opacity="0.24">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,170,110" ViewportUnits="Absolute" Viewbox="0,0,170,110" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M 0,0 L 170,110">
                                        <GeometryDrawing.Pen><Pen Brush="{StaticResource Brush.BorderStrong}" Thickness="1" /></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CCFFFFFF" Offset="0" />
                                <GradientStop Color="#55FFFFFF" Offset="0.58" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <StackPanel Width="470" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="148,140,0,0">
                        <Border Width="72" Height="72" HorizontalAlignment="Left" Background="#F7F5EE" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="16">
                            <Image Source="/Assets/branding/horizon-mark.png" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="OPTIMIZE&#x0a;WITH CONFIDENCE."
                                   Style="{StaticResource DisplayHeading}"
                                   Margin="0,76,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Width="480" MinHeight="610" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="0,0,0,36" Padding="40,36,40,32"
                        Background="#E6101010" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="24">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="18" Opacity="0.38" Direction="270" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Welcome back" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="Sign in to Horizon." Style="{StaticResource BodyText}" Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,24">
                            <Button Style="{StaticResource AuthProviderButton}" Command="{Binding ProviderCommand}" CommandParameter="Discord"
                                    ToolTip="{Binding DiscordToolTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Sign in with Discord" TabIndex="0">
                                <Rectangle Width="24" Height="24" Fill="{StaticResource Brush.TextPrimary}">
                                    <Rectangle.OpacityMask><ImageBrush ImageSource="/Assets/providers/discord.png" Stretch="Uniform" /></Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                            <Button Style="{StaticResource AuthProviderButton}" Command="{Binding ProviderCommand}" CommandParameter="Google" Margin="12,0"
                                    ToolTip="{Binding GoogleToolTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Sign in with Google" TabIndex="1">
                                <Rectangle Width="24" Height="24" Fill="{StaticResource Brush.TextPrimary}">
                                    <Rectangle.OpacityMask><ImageBrush ImageSource="/Assets/providers/google.png" Stretch="Uniform" /></Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                            <Button Style="{StaticResource AuthProviderButton}" Command="{Binding ProviderCommand}" CommandParameter="Epic Games"
                                    ToolTip="{Binding EpicToolTip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="Sign in with Epic Games" TabIndex="2">
                                <Rectangle Width="24" Height="24" Fill="{StaticResource Brush.TextPrimary}">
                                    <Rectangle.OpacityMask><ImageBrush ImageSource="/Assets/providers/epic-games.png" Stretch="Uniform" /></Rectangle.OpacityMask>
                                </Rectangle>
                            </Button>
                        </StackPanel>

                        <Grid Height="20">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Height="1" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="OR" Style="{StaticResource Eyebrow}" FontSize="10" Margin="12,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Email Address" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,20,0,8" />
                        <Grid>
                            <TextBox Style="{StaticResource TextInput}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" TabIndex="3"
                                     AutomationProperties.Name="Email address" />
                            <TextBlock Text="name@example.com" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" Margin="16,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding IsEmailEmpty, Converter={StaticResource BooleanToVisibility}}" />
                        </Grid>

                        <TextBlock Text="Password" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,16,0,8" />
                        <Grid>
                            <PasswordBox x:Name="Password" Style="{StaticResource PasswordInput}" PasswordChanged="Password_PasswordChanged" TabIndex="4"
                                         AutomationProperties.Name="Password" />
                            <TextBlock x:Name="PasswordWatermark" Text="Enter your password" FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <Button Style="{StaticResource GhostButton}" MinWidth="0" Height="30" Padding="0" HorizontalAlignment="Right"
                                Content="Forgot password?" Command="{Binding ResetPasswordCommand}" Margin="0,8,0,10" TabIndex="5" />

                        <Border Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibility}}"
                                Background="{StaticResource Brush.Elevated}" BorderBrush="{Binding StatusTone, Converter={StaticResource StatusBrushConverter}}"
                                BorderThickness="3,0,0,0" CornerRadius="6" Padding="12,9" Margin="0,0,0,12"
                                AutomationProperties.LiveSetting="Polite">
                            <StackPanel>
                                <TextBlock Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}" Height="48" Content="{Binding PrimaryActionLabel}"
                                Command="{Binding SignInCommand}" IsDefault="True" TabIndex="6" AutomationProperties.Name="Sign in" />
                        <ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource Brush.TextPrimary}" Background="Transparent"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <TextBlock Text="New to Horizon?" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" />
                            <Button Style="{StaticResource GhostButton}" MinWidth="0" Height="24" Padding="0" Margin="8,-4,0,0"
                                    Content="Create account" FontSize="13" Command="{Binding CreateAccountCommand}" TabIndex="7" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
