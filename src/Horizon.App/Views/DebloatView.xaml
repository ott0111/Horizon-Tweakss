<UserControl x:Class="Horizon.App.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
            <TextBlock Text="Choose the optional apps you no longer want." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#17140E"
                BorderBrush="{StaticResource Brush.Warning}"
                BorderThickness="3,0,0,0"
                CornerRadius="6"
                Padding="16,14"
                Margin="0,26,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE88E;" FontFamily="{StaticResource Font.Material}" Foreground="{StaticResource Brush.Warning}" FontSize="20" />
                <TextBlock Text="Only apps you select will be removed. Protected Windows components stay untouched."
                           Style="{StaticResource BodyText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,22,0">
                    <ListBox ItemsSource="{Binding Items}" Style="{StaticResource VirtualizedList}" ItemContainerStyle="{StaticResource PassiveListItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding Package.Removable}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Package.Name, StringFormat=Select {0}}" />
                                        <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                            <TextBlock Text="{Binding Package.Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Package.Publisher}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Package.Group}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Background="{StaticResource Brush.Elevated}" Padding="24" VerticalAlignment="Top" MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="YOUR SELECTION" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Remove only what you choose" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,22,0,0" />
                        <TextBlock Text="Windows may reinstall some Store apps after a major update."
                                   Style="{StaticResource BodyText}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                    <Button Grid.Row="1"
                            Style="{StaticResource PrimaryButton}"
                            Content="REMOVE SELECTED"
                            Command="{Binding RemoveCommand}"
                            AutomationProperties.Name="Remove selected apps" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
