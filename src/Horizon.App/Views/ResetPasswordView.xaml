<UserControl x:Class="Horizon.App.Views.ResetPasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Brush.App}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="520" MinHeight="620">
        <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="20">
            <StackPanel>
                <Button Style="{StaticResource GhostButton}" MinWidth="0" Height="28" Padding="0" HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="&#x2190;  BACK TO SIGN IN" AutomationProperties.Name="Back to sign in" />
                <TextBlock Text="Choose a new password" FontSize="30" FontWeight="Bold" Margin="0,24,0,0" />
                <TextBlock Text="{Binding Email, StringFormat=Enter the reset code sent to {0}.}" Style="{StaticResource BodyText}" Margin="0,7,0,24" TextWrapping="Wrap" />
                <TextBlock Text="Reset code" Style="{StaticResource CaptionText}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource TextInput}" Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reset code" />
                <TextBlock Text="New password" Style="{StaticResource CaptionText}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,16,0,8" />
                <PasswordBox x:Name="ResetPassword" Style="{StaticResource PasswordInput}" PasswordChanged="ResetPassword_Changed" AutomationProperties.Name="New password" />
                <TextBlock Text="Use at least 10 characters." Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <TextBlock Text="Confirm password" Style="{StaticResource CaptionText}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,16,0,8" />
                <PasswordBox x:Name="ResetConfirmPassword" Style="{StaticResource PasswordInput}" PasswordChanged="ResetConfirmPassword_Changed" AutomationProperties.Name="Confirm new password" />
                <Border Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibility}}" Background="{StaticResource Brush.Elevated}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="12,9" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Height="48" Content="UPDATE PASSWORD" Command="{Binding ResetCommand}" Margin="0,20,0,0" IsDefault="True" AutomationProperties.Name="Update password" />
                <ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource Brush.TextPrimary}" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
