<UserControl x:Class="Horizon.App.Views.CompatibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageShellWide}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
            <TextBlock Text="See which Horizon changes are ready, active, or unavailable on this PC." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{StaticResource Brush.Elevated}" Padding="24" Margin="0,28,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Text="COMPATIBILITY SUMMARY" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding OverallSummary}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="Results use this PC's detected hardware and Windows configuration." Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SupportedCount}" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="SUPPORTED" Style="{StaticResource Eyebrow}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="22,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReadyCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Success}" />
                    <TextBlock Text="READY NOW" Style="{StaticResource Eyebrow}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="22,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AttentionCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Warning}" />
                    <TextBlock Text="NEEDS REVIEW" Style="{StaticResource Eyebrow}" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="DETAILED RESULTS" Style="{StaticResource Eyebrow}" Margin="4,0,0,12" />

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <ListBox ItemsSource="{Binding Checks}" Style="{StaticResource VirtualizedList}" AutomationProperties.Name="Compatibility results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" BorderBrush="{Binding Tone, Converter={StaticResource StatusBrushConverter}}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding Tone, Converter={StaticResource StatusBrushConverter}}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
