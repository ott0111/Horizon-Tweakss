<UserControl x:Class="Horizon.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
            <TextBlock Text="Choose which apps can open when you sign in to Windows." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,30,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="APPLICATION" Style="{StaticResource Eyebrow}" />
            <TextBlock Grid.Column="1" Text="STARTUP IMPACT" Style="{StaticResource Eyebrow}" />
            <TextBlock Grid.Column="2" Text="ENABLED" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                <ListBox ItemsSource="{Binding Items}" Style="{StaticResource VirtualizedList}" ItemContainerStyle="{StaticResource PassiveListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding App.Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding App.Publisher}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.Impact}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </Border>
                                    <ToggleButton Grid.Column="2"
                                                  Style="{StaticResource SwitchToggle}"
                                                  IsChecked="{Binding Enabled}"
                                                  Command="{Binding ToggleCommand}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding App.Name, StringFormat=Allow {0} at startup}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Border>
    </Grid>
</UserControl>
