<UserControl x:Class="Horizon.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CleanupProgress" TargetType="ProgressBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Scanning">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cleaning">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                <TextBlock Text="Choose what to clean and see how much space you can recover." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}"
                    Content="RESCAN"
                    Command="{Binding ScanCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Rescan cleanup files" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,24,0" VerticalAlignment="Top">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category.Icon}"
                                                   FontFamily="{StaticResource Font.Material}"
                                                   FontSize="22"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding Category.Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Category.Description}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Category.DisplaySize}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                        <ToggleButton Grid.Column="3"
                                                      Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Category.Name, StringFormat=Clean {0}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Background="{StaticResource Brush.Elevated}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding State}" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding SelectedSize}" FontSize="42" FontWeight="Bold" Margin="0,26,0,0" />
                        <TextBlock Text="selected to clean" Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                        <TextBlock Text="Personal files and important Windows data are never included."
                                   Style="{StaticResource BodyText}"
                                   Margin="0,26,0,0" />
                        <ProgressBar Style="{StaticResource CleanupProgress}"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Maximum="100"
                                     Margin="0,24,0,0" />
                        <Border Visibility="{Binding State, Converter={StaticResource EnumToVisibility}, ConverterParameter=Error}"
                                Background="#17100F"
                                BorderBrush="{StaticResource Brush.Danger}"
                                BorderThickness="3,0,0,0"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,20,0,0">
                            <TextBlock Text="Cleanup couldn't scan this PC. Try again." Style="{StaticResource BodyText}" />
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="{Binding CleanActionLabel}"
                                Command="{Binding CleanCommand}"
                                Margin="0,28,0,0"
                                AutomationProperties.Name="Clean selected files" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
