<UserControl x:Class="Horizon.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
            <TextBlock Text="Return supported settings to the values Horizon recorded before changing them."
                       Style="{StaticResource BodyText}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,28,0,24">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="UNDO LAST OPTIMIZATION"
                    Command="{Binding UndoCommand}"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Undo last optimization" />
            <Button Style="{StaticResource SecondaryButton}"
                    Content="RESTORE ALL HORIZON CHANGES"
                    Command="{Binding RestoreAllCommand}"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Restore all Horizon changes" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                <ListBox ItemsSource="{Binding Sessions}" Style="{StaticResource VirtualizedList}" ItemContainerStyle="{StaticResource PassiveListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="{StaticResource Brush.Elevated}" CornerRadius="9">
                                        <TextBlock Text="&#xE8B3;" FontFamily="{StaticResource Font.Material}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,24,0">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StartedAt, StringFormat={}{0:g}}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ChangeCount, StringFormat={}{0} changes}"
                                               Foreground="{StaticResource Brush.Success}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="3"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="RESTORE"
                                            Command="{Binding DataContext.RestoreSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Restore {0}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Border>
    </Grid>
</UserControl>
