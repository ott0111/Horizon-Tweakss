<UserControl x:Class="Horizon.App.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
            <TextBlock Text="Choose a topic, describe what happened, and share only the details you want." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,30,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Padding" Value="26" /><Setter Property="Margin" Value="0,0,20,0" />
                        <Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="What can we help with?" Style="{StaticResource Heading2}" />
                        <TextBlock Text="Pick a starting point or write your own message." Style="{StaticResource BodyText}" Margin="0,7,0,0" />
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Topics}" Margin="-6,20,-6,14">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.SelectTopicCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="6" MinWidth="0" AutomationProperties.Name="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Grid.Row="2" Style="{StaticResource TextInput}" Height="Auto" MinHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="16" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Support message" />
                    <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="COPY &amp; OPEN DISCORD" Command="{Binding SendCommand}" HorizontalAlignment="Left" MinWidth="210" Margin="0,20,0,0" AutomationProperties.Name="Copy message and open Discord support" />
                </Grid>
            </Border>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Column" Value="1" />
                        <Style.Triggers><DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LessThanConverter}, ConverterParameter=1000}" Value="True"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,20,0,0" /></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Community support" Style="{StaticResource Heading2}" />
                        <TextBlock Text="Ask a question or follow Horizon updates in Discord." Style="{StaticResource BodyText}" Margin="0,9,0,20" />
                        <Button Style="{StaticResource SecondaryButton}" Content="OPEN DISCORD" Command="{Binding OpenDiscordCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Open Horizon Discord" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnostic report" Style="{StaticResource Heading2}" />
                        <TextBlock Text="Save a plain-text hardware summary to attach to your request. Account credentials, session tokens, settings, and personal files are excluded." Style="{StaticResource BodyText}" Margin="0,9,0,20" />
                        <Button Style="{StaticResource SecondaryButton}" Content="EXPORT REPORT" Command="{Binding ExportDiagnosticCommand}" HorizontalAlignment="Left" AutomationProperties.Name="Export diagnostic report" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
