<UserControl x:Class="Horizon.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid Style="{StaticResource PageShellWide}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,28,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="156" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,12,0">
                    <TextBox Style="{StaticResource TextInput}"
                             Height="46"
                             Padding="44,0,14,0"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search tweaks" />
                    <TextBlock Text="&#xE8B6;"
                               FontFamily="{StaticResource Font.Material}"
                               FontSize="20"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleFilterCommand}"
                        AutomationProperties.Name="Open tweak filters">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE152;" FontFamily="{StaticResource Font.Material}" FontSize="18" />
                        <TextBlock Text="FILTERS" Margin="9,0,0,0" />
                        <Border Background="White" CornerRadius="8" Margin="9,0,0,0" Padding="6,1">
                            <TextBlock Text="{Binding FilterCount}" Foreground="Black" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*" />
                    <ColumnDefinition Width="{Binding Selected, Converter={StaticResource DetailColumnWidthConverter}}" />
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         Margin="0,0,24,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Tweaks catalogue">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="18,17"
                                                CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Surface}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Selected}" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid AutomationProperties.Name="{Binding Definition.Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Definition.Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Definition.Description}"
                                               Style="{StaticResource CaptionText}"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Margin="0,6,16,0"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{StaticResource Brush.Elevated}"
                                        BorderBrush="{Binding Status.State, Converter={StaticResource StatusBrushConverter}}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,5"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status.State}"
                                               Foreground="{Binding Status.State, Converter={StaticResource StatusBrushConverter}}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextOptions.TextFormattingMode="Display" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="&#xE5CC;"
                                           FontFamily="{StaticResource Font.Material}"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           FontSize="20"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Column="1"
                        Visibility="{Binding Selected, Converter={StaticResource NullToVisibilityConverter}}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="28"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Selected.Definition.Category}" Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource Eyebrow}" />
                                    <TextBlock Text="{Binding Selected.Status.State}" Style="{StaticResource Eyebrow}"
                                               Foreground="{Binding Selected.Status.State, Converter={StaticResource StatusBrushConverter}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Selected.Definition.Name}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,18,0,0" />
                                <TextBlock Text="{Binding Selected.Definition.WhatItDoes}"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,14,0,0" />

                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,24,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="CURRENT" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="{Binding Selected.Status.CurrentValue}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="HORIZON" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="{Binding Selected.Status.HorizonValue}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,28,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,14,18">
                                        <TextBlock Text="COMPATIBILITY" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding SelectedCompatibility}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,18">
                                        <TextBlock Text="RISK" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding Selected.Definition.Risk}" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,14,18">
                                        <TextBlock Text="RESTART" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding SelectedRestart}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,18">
                                        <TextBlock Text="CHANGE TYPE" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding SelectedMode}" Margin="0,7,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                        <TextBlock Text="RESTORE" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding SelectedRestore}" Margin="0,7,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="1"
                                Style="{StaticResource PrimaryButton}"
                                Content="{Binding SelectedActionLabel}"
                                Command="{Binding ApplySelectedCommand}"
                                Visibility="{Binding SelectedActionAvailable, Converter={StaticResource BooleanToVisibility}}"
                                Margin="0,24,0,0"
                                AutomationProperties.Name="Apply or restore selected tweak" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding SelectedActionHelp}"
                                   Style="{StaticResource CaptionText}"
                                   Visibility="{Binding SelectedActionAvailable, Converter={StaticResource InverseBooleanToVisibility}}"
                                   Margin="0,24,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- A page-level modal, intentionally not a dropdown. -->
        <Grid Panel.ZIndex="100"
              Background="#D9050505"
              Visibility="{Binding IsFilterOpen, Converter={StaticResource BooleanToVisibility}}">
            <Border Width="560"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Filter tweaks" Style="{StaticResource Heading2}" />
                            <TextBlock Text="Show only the changes you want to review." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource GhostButton}"
                                MinWidth="40"
                                Width="40"
                                Height="40"
                                Padding="0"
                                Command="{Binding CloseFilterCommand}"
                                AutomationProperties.Name="Close tweak filters">
                            <TextBlock Text="&#xE5CD;" FontFamily="{StaticResource Font.Material}" FontSize="20" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="CATEGORY" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <ComboBox Style="{StaticResource ComboInput}"
                                      Height="46"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding Category}"
                                      AutomationProperties.Name="Tweak category" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="RISK" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                            <ComboBox Style="{StaticResource ComboInput}"
                                      Height="46"
                                      ItemsSource="{Binding Risks}"
                                      SelectedItem="{Binding Risk}"
                                      AutomationProperties.Name="Tweak risk" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,22,0,0">
                        <TextBlock Text="STATUS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                        <ComboBox Style="{StaticResource ComboInput}"
                                  Height="46"
                                  ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding Status}"
                                  AutomationProperties.Name="Tweak status" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,22,0,0">
                        <TextBlock Text="QUICK FILTERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,12" />
                        <CheckBox Content="Recommended for this PC" IsChecked="{Binding RecommendedOnly}" Foreground="White" FontSize="14" Padding="0,5" />
                        <CheckBox Content="Currently applied" IsChecked="{Binding AppliedOnly}" Foreground="White" FontSize="14" Padding="0,5" Margin="0,6,0,0" />
                        <CheckBox Content="Ready to apply" IsChecked="{Binding NotAppliedOnly}" Foreground="White" FontSize="14" Padding="0,5" Margin="0,6,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,26,0,0">
                        <Button Style="{StaticResource GhostButton}"
                                Content="CLEAR"
                                HorizontalAlignment="Left"
                                Command="{Binding ClearFiltersCommand}"
                                AutomationProperties.Name="Clear tweak filters" />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="APPLY FILTERS"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseFilterCommand}"
                                AutomationProperties.Name="Show filtered tweaks" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
