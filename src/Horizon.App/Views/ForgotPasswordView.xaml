<UserControl x:Class="Horizon.App.Views.ForgotPasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Brush.App}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid MinWidth="520" MinHeight="500">
        <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="20">
            <StackPanel>
                <Button Style="{StaticResource GhostButton}" MinWidth="0" Height="28" Padding="0" HorizontalAlignment="Left" Command="{Binding BackCommand}" Content="&#x2190;  BACK TO SIGN IN" AutomationProperties.Name="Back to sign in" />
                <TextBlock Text="Reset your password" FontSize="30" FontWeight="Bold" Margin="0,24,0,0" />
                <TextBlock Text="Enter your account email and we'll send you a reset code." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,7,0,24" />
                <TextBlock Text="Email address" Style="{StaticResource CaptionText}" FontWeight="Medium" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource TextInput}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email address" />
                <Border Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibility}}" Background="{StaticResource Brush.Elevated}" BorderBrush="{StaticResource Brush.Danger}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="12,9" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Height="48" Content="SEND RESET CODE" Command="{Binding SendCommand}" Margin="0,20,0,0" IsDefault="True" AutomationProperties.Name="Send reset code" />
                <ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource Brush.TextPrimary}" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
