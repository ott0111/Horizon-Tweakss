<UserControl x:Class="Horizon.App.Views.FortniteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DetectionBadge" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Detected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetectionText" TargetType="TextBlock">
            <Setter Property="Text" Value="NOT DETECTED" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Detected}" Value="True">
                    <Setter Property="Text" Value="DETECTED" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid Style="{StaticResource PageShell}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                <TextBlock Text="Tune Fortnite for responsive, consistent play." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,30,0,20" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" Background="{StaticResource Brush.Elevated}" CornerRadius="12">
                        <TextBlock Text="&#xEA28;" FontFamily="{StaticResource Font.Material}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0">
                        <TextBlock Text="FORTNITE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding InstallPath}" FontSize="14" FontWeight="Medium" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource DetectionBadge}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DetectionText}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,18,0" Padding="28">
                    <StackPanel>
                        <TextBlock Text="COMPETITIVE PROFILE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Built for responsive play" FontSize="24" FontWeight="Bold" Margin="0,18,0,0" />
                        <TextBlock Text="Applies supported Fortnite and Windows settings for lower latency and clearer competitive visuals."
                                   Style="{StaticResource BodyText}" Margin="0,12,0,24" />
                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE5CA;" FontFamily="{StaticResource Font.Material}" Foreground="{StaticResource Brush.Success}" FontSize="18" />
                                    <TextBlock Text="Backs up your current settings" Style="{StaticResource BodyText}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="&#xE5CA;" FontFamily="{StaticResource Font.Material}" Foreground="{StaticResource Brush.Success}" FontSize="18" />
                                    <TextBlock Text="Matches settings to this PC" Style="{StaticResource BodyText}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="&#xE5CA;" FontFamily="{StaticResource Font.Material}" Foreground="{StaticResource Brush.Success}" FontSize="18" />
                                    <TextBlock Text="Can be restored at any time" Style="{StaticResource BodyText}" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="APPLY PROFILE" Command="{Binding ApplyCommand}" Margin="0,28,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Apply Fortnite profile" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="24">
                        <Grid>
                            <StackPanel Margin="0,0,72,0">
                                <TextBlock Text="Include temporary gaming mode" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="When you apply the profile, use temporary performance settings while Fortnite is running and restore them when it closes."
                                           Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding TemporaryMode}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Temporary Fortnite gaming mode" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="NVIDIA profile" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Available on compatible NVIDIA graphics cards." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                            <Border BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Margin="0,18,0,0">
                                <TextBlock Text="HARDWARE SPECIFIC" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
