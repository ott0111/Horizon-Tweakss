<UserControl x:Class="Horizon.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Style="{StaticResource PageShellWide}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                    <TextBlock Text="A clear overview of this PC." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}"
                        Content="RESCAN"
                        Command="{Binding RescanCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Rescan system information" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,30,0,12">
                <TextBlock Text="Overview" Style="{StaticResource Heading2}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="DEVICE" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding Snapshot.DeviceName}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="WINDOWS" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding Snapshot.WindowsEdition}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Snapshot.WindowsBuild, StringFormat=Build {0}}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MOTHERBOARD" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding Snapshot.Motherboard}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="Performance" Style="{StaticResource Heading2}" />
                <UniformGrid Columns="3" Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="24">
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding Snapshot.Cpu}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                                <Run Text="{Binding Snapshot.CpuCores}" /><Run Text=" cores  ·  " /><Run Text="{Binding Snapshot.CpuThreads}" /><Run Text=" threads" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="24">
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource Eyebrow}" />
                            <ItemsControl ItemsSource="{Binding Snapshot.Gpus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,12,0,2">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Driver, StringFormat=Driver {0}}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="MEMORY" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding Snapshot.Ram}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <ItemsControl ItemsSource="{Binding Snapshot.MemoryModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,30,0,0">
                <TextBlock Text="Storage" Style="{StaticResource Heading2}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24">
                    <ItemsControl ItemsSource="{Binding Snapshot.Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding MediaType}" Foreground="{StaticResource Brush.TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Health}" Foreground="{StaticResource Brush.Success}" />
                                    <TextBlock Grid.Column="3" Text="{Binding DisplaySize}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,30,0,0">
                <TextBlock Text="Network" Style="{StaticResource Heading2}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24">
                    <ItemsControl ItemsSource="{Binding Snapshot.NetworkAdapters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LinkSpeed}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
