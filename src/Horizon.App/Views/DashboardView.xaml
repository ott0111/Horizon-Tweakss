<UserControl x:Class="Horizon.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
        <Grid Style="{StaticResource PageShellWide}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                </StackPanel>
                <Button Content="REFRESH" Style="{StaticResource SecondaryButton}" Command="{Binding RescanCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="104"
                        AutomationProperties.Name="Refresh dashboard" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,28,0,0" Padding="24,22">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Snapshot.DeviceName}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding SystemSummary}" Style="{StaticResource BodyText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource Brush.Success}"
                                BorderThickness="1" CornerRadius="6" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE876;" FontFamily="{StaticResource Font.Material}" FontSize="13" Foreground="{StaticResource Brush.Success}" />
                                <TextBlock Text="READY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Stats}" Margin="0,22,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="0,0,18,0" Margin="0,0,18,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Material}" FontSize="20"
                                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>

                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Recommended for you" Style="{StaticResource Heading2}" />
                        <Button Content="VIEW ALL" Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="Recommended"
                                HorizontalAlignment="Right" Height="36" MinWidth="84" Padding="10,5" AutomationProperties.Name="View all recommendations" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Recommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,17">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding Definition.Name}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource BodyText}" Margin="0,5,0,0"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border BorderBrush="{StaticResource Brush.Success}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                                                        <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" />
                                                    </Border>
                                                    <Button Content="REVIEW" Style="{StaticResource GhostButton}"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="Recommended" Height="32" MinWidth="68" Padding="8,4" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No recommendations are waiting." Style="{StaticResource BodyText}" Margin="20"
                                       Visibility="{Binding HasRecommendations, Converter={StaticResource InverseBooleanToVisibility}}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="At a glance" Style="{StaticResource Heading2}" Margin="0,0,0,12" />

                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" Background="{StaticResource Brush.Elevated}" CornerRadius="10">
                                <TextBlock Text="&#xE86C;" FontFamily="{StaticResource Font.Material}" FontSize="20" Foreground="{StaticResource Brush.Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{Binding ReadinessTitle}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding ReadinessDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" Background="{StaticResource Brush.Elevated}" CornerRadius="10">
                                <TextBlock Text="&#xEA28;" FontFamily="{StaticResource Font.Material}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{Binding GamingTitle}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding GamingDetail}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Recent activity" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Nothing changed yet." Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                       Visibility="{Binding HasRecentActivity, Converter={StaticResource InverseBooleanToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Material}" FontSize="16" Foreground="{StaticResource Brush.Success}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button Content="CLEANUP" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateCommand}" CommandParameter="Cleanup" MinWidth="0" />
                        <Button Grid.Column="2" Content="SYSTEM" Style="{StaticResource SecondaryButton}" Command="{Binding NavigateCommand}" CommandParameter="System" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
