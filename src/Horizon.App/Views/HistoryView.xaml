<UserControl x:Class="Horizon.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageShell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" />
                <TextBlock Text="Your recent optimizations, cleanup, and restores." Style="{StaticResource BodyText}" Margin="0,8,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}"
                    Content="CLEAR HISTORY"
                    Command="{Binding ClearCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Clear history" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,28,0,0">
                <ListBox ItemsSource="{Binding Sessions}" Style="{StaticResource VirtualizedList}" ItemContainerStyle="{StaticResource PassiveListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,16">
                                <Expander HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StartedAt, StringFormat={}{0:g}}"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ChangeCount, StringFormat={}{0} changes}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Changes}" Margin="0,16,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE5CA;" FontFamily="{StaticResource Font.Material}" Foreground="{StaticResource Brush.Success}" FontSize="18" />
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Border>
    </Grid>
</UserControl>
