<Window x:Class="Horizon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Horizon" Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.App}" FontFamily="{StaticResource Font.Inter}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="24,0,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="46" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/branding/horizon-mark.png" Width="24" Height="24" />
                    <TextBlock Text="HORIZON" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" MinWidth="0" Height="47" Padding="0" Content="&#x2212;" FontFamily="Segoe UI Symbol" FontSize="18" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize Horizon" />
                <Button x:Name="MaximizeButton" Grid.Column="2" Style="{StaticResource GhostButton}" MinWidth="0" Height="47" Padding="0" Content="&#x25A1;" FontFamily="Segoe UI Symbol" FontSize="18" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize Horizon" />
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" MinWidth="0" Height="47" Padding="0" Content="&#x00D7;" FontFamily="Segoe UI Symbol" FontSize="21" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close Horizon" />
            </Grid>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding Current}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <Border x:Name="ToastBorder" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Padding="18,14" MinWidth="280" Background="{StaticResource Brush.Elevated}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="ToastDot" Width="8" Height="8" Fill="{StaticResource Brush.TextSecondary}" Margin="0,0,12,0" /><TextBlock x:Name="ToastText" Style="{StaticResource BodyText}" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" /></StackPanel>
        </Border>
        <Grid x:Name="DialogOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed" Background="#B8000000">
            <Border Width="500" Background="{StaticResource Brush.Elevated}" BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="14" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource Heading2}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogMessage" Grid.Row="1" Style="{StaticResource BodyText}" FontSize="14" LineHeight="22" Margin="0,18,0,30"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DialogSecondary" Style="{StaticResource SecondaryButton}" Click="DialogSecondary_Click"/><Button x:Name="DialogPrimary" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="DialogPrimary_Click"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
