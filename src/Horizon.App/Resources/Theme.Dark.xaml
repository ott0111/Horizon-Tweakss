<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.App">#050505</Color>
    <Color x:Key="Color.Sidebar">#090909</Color>
    <Color x:Key="Color.Surface">#0E0E0E</Color>
    <Color x:Key="Color.Elevated">#141414</Color>
    <Color x:Key="Color.Selected">#171717</Color>
    <Color x:Key="Color.Border">#222222</Color>
    <Color x:Key="Color.BorderStrong">#323232</Color>
    <Color x:Key="Color.TextPrimary">#F5F5F5</Color>
    <Color x:Key="Color.TextSecondary">#A3A3A3</Color>
    <Color x:Key="Color.TextMuted">#666666</Color>
    <Color x:Key="Color.Success">#5AC98A</Color>
    <Color x:Key="Color.Warning">#D6A84C</Color>
    <Color x:Key="Color.Danger">#E06161</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>
    <Color x:Key="Color.Black">#000000</Color>

    <SolidColorBrush x:Key="Brush.App" Color="{StaticResource Color.App}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="{StaticResource Color.Elevated}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.PrimaryAction" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.PrimaryActionText" Color="{StaticResource Color.Black}" />

    <FontFamily x:Key="Font.Inter">pack://application:,,,/Horizon;component/Assets/fonts/#Inter Variable Text, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Anton">pack://application:,,,/Horizon;component/Assets/fonts/#Anton, Impact, Arial Narrow</FontFamily>
    <FontFamily x:Key="Font.Material">pack://application:,,,/Horizon;component/Assets/fonts/#Material Symbols Rounded</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.App}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource Font.Inter}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
